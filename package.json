{
  "name": "fueltrippk",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "expo export --platform web",
    "build:native": "expo export --platform android --platform ios",
    "check": "npm run lint && npm run format:check && npm test && npm run test:build-tools",
    "test:build-tools": "node --test tests/build-tools.test.cjs tests/fuel-price-parser.test.cjs",
    "update:fuel-prices": "node scripts/update-fuel-prices.cjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.0",
    "@react-navigation/native-stack": "^7.17.1",
    "expo": "~57.0.0",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-location": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "private": true,
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.2.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "cacheDirectory": "<rootDir>/.jest-cache",
    "modulePathIgnorePatterns": [
      "<rootDir>/.expo/",
      "<rootDir>/dist/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "overrides": {
    "react-server-dom-webpack": "19.1.9"
  }
}
