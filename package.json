{
  "name": "fueltrippk",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "expo export --platform web",
    "build:native": "expo export --platform android --platform ios",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.0",
    "@react-navigation/native-stack": "^7.17.1",
    "expo": "~54.0.34",
    "expo-file-system": "~19.0.23",
    "expo-location": "~19.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "private": true,
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "cacheDirectory": "<rootDir>/.jest-cache"
  }
}
