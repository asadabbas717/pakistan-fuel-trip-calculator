      "content": "'use strict';\n// SafarWise backport: bound AST traversal before recursive braces walkers.\nmodule.exports = function checkDepth(root) {\n  const stack = [[root, 0]];\n  const seen = new Set();\n  while (stack.length) {\n    const [node, depth] = stack.pop();\n    if (!node || typeof node !== 'object') continue;\n    if (depth > 128 || seen.has(node) || seen.size >= 100000) {\n      throw new RangeError('Brace nesting exceeds safe limit');\n    }\n    seen.add(node);\n    if (Array.isArray(node.nodes)) {\n      for (const child of node.nodes) stack.push([child, depth + 1]);\n    }\n  }\n};\n"
    },
